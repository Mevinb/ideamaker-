# Your local OmniRoute gateway. Run `omniroute` before starting IdeaArena.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Set only when your OmniRoute instance requires authentication.
OMNIROUTE_API_KEY=
# Read-only account/model metadata. Defaults to ~/.omniroute/storage.sqlite.
# OMNIROUTE_DATABASE_PATH=/path/to/omniroute/storage.sqlite
# Optional. Enables evidence-backed novelty research.
TAVILY_API_KEY=
